# Google Gemini API Key (Get from https://aistudio.google.com/app/api-keys)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# CopilotKit Intelligence & Project Configuration (Analytics & Telemetry)
COPILOTKIT_PROJECT_ID=17614
COPILOTKIT_LEARNING_CONTAINER_ID=genui-learning-container

# CopilotKit Intelligence Cloud API Key (Get from https://intelligence.copilotkit.ai)
CPK_INTELLIGENCE_API_KEY=your_copilotkit_intelligence_api_key_here
COPILOTKIT_INTELLIGENCE_API_KEY=your_copilotkit_intelligence_api_key_here

# Excalidraw MCP Server for Generative Canvas
MCP_SERVER_URL=https://mcp.excalidraw.com

# CopilotKit Telemetry & Web Inspector
COPILOTKIT_TELEMETRY_DISABLED=false
NEXT_PUBLIC_COPILOTKIT_ENABLE_INSPECTOR=true

# Backend & Database Configuration
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/genui_db
REDIS_URL=redis://localhost:6379/0
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Next.js & Auth Configuration
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXTAUTH_SECRET=genui_super_secret_guest_session_key_2026
NEXTAUTH_URL=http://localhost:3000
